{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "spicy-rodents/cast",
  "title": "Named human cast (data/authored/cast/cast.json), BUILD_PLAN 3.12, humans_actors 1-3",
  "type": "object",
  "required": [
    "cast"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "src": {
      "type": "string"
    },
    "cast": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/member"
      }
    }
  },
  "$defs": {
    "member": {
      "type": "object",
      "required": [
        "id",
        "name",
        "role",
        "personality",
        "home",
        "src"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "homeLot": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z][A-Za-z0-9_.\\-]*$",
          "description": "lot id when the home string names one (cross-checked against the lots)"
        },
        "home": {
          "type": "string",
          "description": "the home description exactly as the spec extractor wrote it"
        },
        "personality": {
          "enum": [
            "wary",
            "panic",
            "brave",
            "bluster",
            "n/a"
          ],
          "description": "normalised; the original string is kept in personalityNote when it carried more"
        },
        "nerve": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "look": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "skinTone": {
              "type": "string"
            },
            "outfit": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "accessory": {
              "type": "string"
            }
          }
        },
        "spawnRule": {
          "type": "string"
        },
        "specialProps": {
          "type": "string"
        },
        "schedule": {
          "type": [
            "object",
            "array",
            "string"
          ]
        },
        "possessable": {
          "type": "boolean"
        },
        "src": {
          "type": "string",
          "pattern": "^v5\\.4 L\\d+"
        },
        "personalityNote": {
          "type": "string"
        }
      }
    }
  }
}
