{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "spicy-rodents/lots",
  "title": "Lots of one district (data/authored/town/lots/<district>.json), BUILD_PLAN 3.2",
  "type": "object",
  "required": [
    "district",
    "lots"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "district": {
      "$ref": "#/$defs/id"
    },
    "src": {
      "type": "string"
    },
    "lots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lot"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.\\-]*$",
      "minLength": 2,
      "maxLength": 80,
      "description": "spec ids are preserved verbatim (they may contain uppercase, e.g. env_shrub_cluster_A)"
    },
    "src": {
      "type": "string",
      "pattern": "^v5\\.4 L\\d+"
    },
    "u": {
      "type": "number",
      "x-unit": "u"
    },
    "lot": {
      "type": "object",
      "required": [
        "id",
        "district",
        "type",
        "x",
        "z",
        "hasInterior",
        "src"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "stable; spec ids preserved (routes, cast and saves refer to it)"
        },
        "district": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "-> data/lot_types/<type>.json (W1)"
        },
        "archetype": {
          "type": "string"
        },
        "x": {
          "$ref": "#/$defs/u",
          "description": "lot centre, HTML units"
        },
        "z": {
          "$ref": "#/$defs/u"
        },
        "facing": {
          "enum": [
            "+X",
            "-X",
            "+Z",
            "-Z",
            null
          ],
          "description": "world axis the front faces; absent for lots without a front"
        },
        "yaw": {
          "type": [
            "number",
            "null"
          ],
          "x-unit": "rad",
          "description": "HTML yaw in radians when the lot is not axis aligned"
        },
        "footprint": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "w",
            "d"
          ],
          "additionalProperties": false,
          "properties": {
            "w": {
              "type": "number",
              "exclusiveMinimum": 0,
              "x-unit": "u"
            },
            "d": {
              "type": "number",
              "exclusiveMinimum": 0,
              "x-unit": "u"
            }
          },
          "description": "world-axis extents after rotation (worldgen_core 1); null for point-like lots"
        },
        "seat": {
          "type": "string",
          "pattern": "^(graded_pad|terrain_centre|absolute:-?\\d+(\\.\\d+)?)$"
        },
        "params": {
          "type": "object"
        },
        "flair": {
          "type": "object"
        },
        "yard": {
          "type": "object"
        },
        "home": {
          "type": "object"
        },
        "forage": {
          "type": "object"
        },
        "risk": {
          "type": "object"
        },
        "jobs": {
          "type": "object"
        },
        "traffic": {
          "type": "object"
        },
        "routes": {
          "type": "object",
          "required": [
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "enum": [
                "harvest",
                "template",
                "none"
              ]
            }
          }
        },
        "streaming": {
          "enum": [
            "Atomic",
            "Persistent",
            "Default",
            "Nonatomic"
          ]
        },
        "lod": {
          "enum": [
            "SLIM",
            "Automatic",
            "Disabled"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hasInterior": {
          "type": "boolean"
        },
        "style": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "src": {
          "$ref": "#/$defs/src"
        },
        "v54": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "facing": {
              "type": "string",
              "description": "the facing string exactly as the spec extractor wrote it"
            }
          }
        }
      }
    }
  }
}
