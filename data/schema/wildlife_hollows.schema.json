{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "spicy-rodents/wildlife_hollows",
  "title": "Hollow-tree proposals for brief 3/7 (data/authored/wildlife/hollows.json), wildlife_foraging 6.5; the final data/town/hollows.json (BUILD_PLAN 3.5) is authored in W1",
  "type": "object",
  "required": ["premium", "knothole"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "src": { "type": "string" },
    "premium": { "type": "array", "items": { "$ref": "#/$defs/hollow" } },
    "knothole": { "type": "array", "items": { "$ref": "#/$defs/hollow" } },
    "alternates": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "xz": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2, "x-unit": "u" },
    "hollow": {
      "type": "object", "required": ["id", "tree", "x", "z"],
      "properties": {
        "id": { "type": "string", "pattern": "^H\\d+$" },
        "tree": { "type": "string" },
        "x": { "type": "number", "x-unit": "u" }, "z": { "type": "number", "x-unit": "u" },
        "groundY": { "type": "number", "x-unit": "u" }, "H": { "type": "number", "x-unit": "u" },
        "why": { "type": "string" }, "district": { "type": "string" }, "replaceModel": { "type": "boolean" },
        "premiumGarden": { "$ref": "#/$defs/xz" }, "premiumFeeder": { "$ref": "#/$defs/xz" }
      }
    }
  }
}
