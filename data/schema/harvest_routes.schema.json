{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "spicy-rodents/harvest_routes",
  "title": "Harvested v5.4 routes (data/harvest/routes.json, machine output of tools/harvest)",
  "type": "object",
  "required": ["pin", "count", "routes"],
  "additionalProperties": true,
  "properties": {
    "pin": { "type": "object", "required": ["sha256"], "properties": { "sha256": { "type": "string", "pattern": "^[0-9a-f]+$", "minLength": 64, "maxLength": 64 } } },
    "count": { "type": "integer" },
    "routes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "speed", "surfaceRadius", "length", "indexed", "points", "sampleCount"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer", "minimum": 0 },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["trunk", "branch", "bridge", "lookout", "roof", "wire", "fence", "trampoline"] },
          "speed": { "type": "number", "exclusiveMinimum": 0 },
          "center": { "type": ["array", "null"], "items": { "type": "number" }, "minItems": 3, "maxItems": 3, "x-unit": "u" },
          "surfaceRadius": { "type": "number", "exclusiveMinimum": 0, "x-unit": "u" },
          "visualOffset": { "type": ["number", "null"], "x-unit": "u" },
          "length": { "type": "number", "minimum": 0.04, "x-unit": "u" },
          "indexed": { "type": "boolean" },
          "trunkClearance": { "type": ["number", "null"], "x-unit": "u" },
          "points": { "type": "array", "minItems": 2, "items": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }, "x-unit": "u" },
          "sampleCount": { "type": "integer", "minimum": 21 },
          "callSite": { "type": ["object", "null"], "properties": { "line": { "type": "integer" }, "col": { "type": "integer" }, "fn": { "type": ["string", "null"] } } }
        }
      }
    }
  }
}
