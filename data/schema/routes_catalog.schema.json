{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "spicy-rodents/routes_catalog",
  "title": "Route generator catalogue (data/authored/routes/catalog.json): one entry per addRoute call site, routes_movement 2",
  "type": "object",
  "required": [
    "generators"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "src": {
      "type": "string"
    },
    "generators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/generator"
      }
    }
  },
  "$defs": {
    "generator": {
      "type": "object",
      "required": [
        "generator",
        "kind",
        "line",
        "formula",
        "count",
        "speed",
        "surfaceRadius",
        "src"
      ],
      "additionalProperties": false,
      "properties": {
        "generator": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "trunk",
            "branch",
            "bridge",
            "lookout",
            "roof",
            "wire",
            "fence",
            "trampoline"
          ]
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "description": "the addRoute( line in v5_4_game.js; equals the harvest callSite.line"
        },
        "formula": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "description": "instances created per load (cross-checked against the harvest)"
        },
        "speed": {
          "oneOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          ],
          "description": "route.speed as stored (never read by movement code; D8 note)"
        },
        "surfaceRadius": {
          "x-unit": "u",
          "description": "per-instance radius; a list when the generator varies it (giant trunks: 0.95 x tree radius)",
          "oneOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          ]
        },
        "visualOffset": {
          "type": [
            "number",
            "null"
          ],
          "x-unit": "u"
        },
        "connectsTo": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "src": {
          "type": "string",
          "pattern": "^v5\\.4 L\\d+"
        }
      }
    }
  }
}
