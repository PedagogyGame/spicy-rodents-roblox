{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "spicy-rodents/roads",
  "title": "Roads and pavements (data/authored/town/roads.json), BUILD_PLAN 3.6, worldgen_core 4",
  "type": "object",
  "required": [
    "roads"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "src": {
      "type": "string"
    },
    "roads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/road"
      }
    }
  },
  "$defs": {
    "u": {
      "type": "number",
      "x-unit": "u"
    },
    "xz": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2,
      "x-unit": "u"
    },
    "road": {
      "type": "object",
      "required": [
        "id",
        "axis",
        "width",
        "start",
        "end",
        "kind",
        "src"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^rd_\\d\\d\\d_[a-z0-9_.\\-]+$"
        },
        "axis": {
          "enum": [
            "x",
            "z",
            "free"
          ],
          "description": "x: runs along world x at z = coord; z: runs along z at x = coord; free: start/end are [x, z] points"
        },
        "coord": {
          "type": [
            "number",
            "null"
          ],
          "x-unit": "u"
        },
        "start": {
          "x-unit": "u",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/xz"
            }
          ]
        },
        "end": {
          "x-unit": "u",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/xz"
            }
          ]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-unit": "u"
        },
        "kind": {
          "enum": [
            "asphalt",
            "concrete",
            "path",
            "cobble",
            "rail"
          ]
        },
        "class": {
          "enum": [
            "arterial",
            "collector",
            "residential",
            "service",
            "path",
            "rail"
          ]
        },
        "speedLimit": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-unit": "u/s"
        },
        "connects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "registered": {
          "type": "boolean",
          "description": "true when registerPavement recorded it (drives outdoorSurfaceAt/pavementDistance)"
        },
        "notes": {
          "type": "string"
        },
        "src": {
          "type": "string",
          "pattern": "^v5\\.4 L\\d+"
        }
      },
      "description": "axis free: start/end must be [x, z] points (checked by the compiler invariant, not the schema)"
    }
  }
}
