--!strict
-- Shared/Time/Moon and Calendar (BUILD_PLAN §6.2: phase index at days 0, 7.4, 14.8, 22.1).
local Moon = require("@shared/Time/Moon")
local Calendar = require("@shared/Time/Calendar")

return function(t)
	t.test("new moon at day 0", function()
		t.eq(Moon.name(0), "new")
		t.eq(Moon.phaseIndex(0), 1)
	end)
	t.test("first quarter near day 7.4", function()
		t.eq(Moon.name(7.4), "first quarter")
	end)
	t.test("full near day 14.8", function()
		t.eq(Moon.name(14.8), "full")
		t.eq(Moon.phaseIndex(14.8), 5)
	end)
	t.test("last quarter near day 22.1", function()
		t.eq(Moon.name(22.1), "last quarter")
	end)
	t.test("cycle wraps", function()
		t.near(Moon.phase(Moon.SYNODIC_DAYS), 0, 1e-9)
		t.near(Moon.age(Moon.SYNODIC_DAYS + 3), 3, 1e-6)
	end)
	t.test("winter is week 6 of 6", function()
		t.eq(Calendar.week(0), 1)
		t.eq(Calendar.week(35), 6)
		t.truthy(Calendar.isWinter(35))
		t.falsy(Calendar.isWinter(42))
		t.eq(Calendar.week(42), 1)
	end)
	t.test("calendar exposes lunar age through the string-required Moon", function()
		t.near(Calendar.lunarAge(7.4), 7.4, 1e-6)
	end)
end
