{
  "name": "SpicyRodentsCI",
  "globIgnorePaths": ["**/*.spec.luau", "**/README.md", "**/.gitkeep"],
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared",
        "Generated": {
          "$path": { "optional": "generated" }
        }
      },
      "Assets": {
        "$path": "assets"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server",
        "WorldGen": {
          "$path": "src/worldgen"
        }
      }
    },

    "ServerStorage": {
      "EngineTests": {
        "$path": "tests/engine"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Players": {
      "$properties": {
        "CharacterAutoLoads": false,
        "MaxPlayers": 49
      }
    },

    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "ModelStreamingBehavior": "Improved",
        "StreamOutBehavior": "Opportunistic",
        "StreamingMinRadius": 64,
        "StreamingTargetRadius": 1024,
        "PlayerCharacterDestroyBehavior": "Disabled",
        "SignalBehavior": "Deferred",
        "FallenPartsDestroyHeight": -200
      },
      "Terrain": {
        "$className": "Terrain",
        "$properties": {
          "Decoration": false
        }
      },
      "Town": {
        "$path": { "optional": "build/Town.rbxm" }
      },
      "EditorGround": {
        "$path": { "optional": "build/EditorGround.rbxm" }
      },
      "Backdrop": {
        "$path": { "optional": "build/Backdrop.rbxm" }
      },
      "Attractions": {
        "$path": { "optional": "build/Attractions.rbxm" }
      },
      "Expansion": {
        "$className": "Folder",
        "F1": { "$path": { "optional": "build/Expansion_F1.rbxm" } },
        "F2": { "$path": { "optional": "build/Expansion_F2.rbxm" } },
        "F3": { "$path": { "optional": "build/Expansion_F3.rbxm" } },
        "F4": { "$path": { "optional": "build/Expansion_F4.rbxm" } },
        "NeighbourhoodShop": { "$path": { "optional": "build/Expansion_NeighbourhoodShop.rbxm" } }
      }
    },

    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "LightingStyle": "Realistic",
        "GlobalShadows": true,
        "ShadowSoftness": 0.25,
        "GeographicLatitude": 39,
        "ClockTime": 16,
        "Brightness": 2.6,
        "ExposureCompensation": 0.16,
        "ColorShift_Top": [1.0, 0.8784, 0.6706],
        "ColorShift_Bottom": [0.3373, 0.4, 0.2902],
        "OutdoorAmbient": [0.6353, 0.6314, 0.502],
        "Ambient": [0.4196, 0.4157, 0.3529],
        "EnvironmentDiffuseScale": 0.6,
        "EnvironmentSpecularScale": 0.3
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": { "Density": 0.28, "Offset": 0.25, "Color": [0.7843, 0.8196, 0.7412], "Decay": [0.7255, 0.6314, 0.4941], "Glare": 0.2, "Haze": 1.5 }
      },
      "Grade": {
        "$className": "ColorCorrectionEffect",
        "$properties": { "Contrast": 0.05, "Saturation": -0.05, "Brightness": 0, "TintColor": [1, 1, 1] }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": { "Intensity": 0.3, "Size": 28, "Threshold": 1.5 }
      },
      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": { "Intensity": 0.06, "Spread": 0.6 }
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
