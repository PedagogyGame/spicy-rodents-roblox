{
  "name": "SpicyRodentsCI",
  "globIgnorePaths": ["**/*.spec.luau", "**/README.md", "**/.gitkeep"],
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared",
        "Generated": {
          "$path": { "optional": "generated" }
        }
      },
      "Assets": {
        "$path": "assets"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server",
        "WorldGen": {
          "$path": "src/worldgen"
        }
      }
    },

    "ServerStorage": {
      "EngineTests": {
        "$path": "tests/engine"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Players": {
      "$properties": {
        "CharacterAutoLoads": false,
        "MaxPlayers": 49
      }
    },

    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "ModelStreamingBehavior": "Improved",
        "StreamOutBehavior": "Opportunistic",
        "StreamingMinRadius": 64,
        "StreamingTargetRadius": 1024,
        "PlayerCharacterDestroyBehavior": "Disabled",
        "SignalBehavior": "Deferred",
        "FallenPartsDestroyHeight": -200
      },
      "Town": {
        "$path": { "optional": "build/Town.rbxm" }
      },
      "EditorGround": {
        "$path": { "optional": "build/EditorGround.rbxm" }
      },
      "Backdrop": {
        "$path": { "optional": "build/Backdrop.rbxm" }
      },
      "Attractions": {
        "$path": { "optional": "build/Attractions.rbxm" }
      },
      "Expansion": {
        "$className": "Folder",
        "F1": { "$path": { "optional": "build/Expansion_F1.rbxm" } },
        "F2": { "$path": { "optional": "build/Expansion_F2.rbxm" } },
        "F3": { "$path": { "optional": "build/Expansion_F3.rbxm" } },
        "F4": { "$path": { "optional": "build/Expansion_F4.rbxm" } }
      }
    },

    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "GeographicLatitude": 39
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
