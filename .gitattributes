# Text normalisation
* text=auto eol=lf
*.luau text eol=lf
*.json text eol=lf
*.sh text eol=lf

# Git LFS: Blender sources, mesh exports and source textures (BUILD_PLAN §1.2, §5.7).
# git-lfs 3.4.1 is installed in the container; `git lfs install` once per clone.

# Binary Roblox files that are committed (small): mark binary, no LFS.
*.rbxm binary
*.rbxl binary

# Generated files: collapse in diffs.
roblox.yml linguist-generated=true -diff
generated/** linguist-generated=true
data/harvest/** linguist-generated=true
# Git LFS is not used: lfs.github.com is unreachable from the build container (2026-11-09).
# Binary art (.blend, .fbx, .glb, textures) is committed as normal blobs; keep each file small.
*.fbx binary
*.blend binary
*.glb binary
