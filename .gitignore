# Build artifacts (BUILD_PLAN §1.2: build/ is gitignored)
/build/
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxlx.lock
# assets/*.rbxm are committed content; build output .rbxm lives in build/ only

# Sourcemap and type definitions are regenerated by CI
/sourcemap.json
/globalTypes.d.luau
/.luau-analyze.json

# Tooling
node_modules/
/.venv/
/venv/
__pycache__/
*.pyc
.DS_Store
/.rokit/
/.lune/

# Cloud tooling never writes secrets, but keep its local state out of git anyway
/tools/cloud/state/
/tools/cloud/.state/
