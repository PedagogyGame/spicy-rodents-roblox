{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "spicy-rodents/population",
  "title": "Population (data/population.json), BUILD_PLAN 1.5 rev-4 table and 3.12. No player-slot counts (invariant 13: those live in Roles/Ladder).",
  "type": "object",
  "required": ["phases", "hardCap", "reserve", "posts", "nonHumanoid", "animals", "supplyOrder", "fullServerCutOrder", "src"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" }, "src": { "type": "string" },
    "phases": { "type": "array", "items": { "enum": ["frb", "w3c"] } },
    "hardCap": { "$ref": "#/$defs/perPhase" }, "reserve": { "$ref": "#/$defs/perPhase" },
    "posts": { "type": "array", "minItems": 1, "items": { "type": "object",
      "required": ["id", "species", "standing", "floor", "fullFloor", "neverCut", "site"], "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "species": { "const": "human" }, "standing": { "$ref": "#/$defs/perPhase" },
        "floor": { "$ref": "#/$defs/perPhase" }, "fullFloor": { "$ref": "#/$defs/perPhase" }, "neverCut": { "type": "boolean" },
        "site": { "type": "string" }, "infectedAtStart": { "type": "integer", "minimum": 0 }, "officerFloor": { "type": "integer", "minimum": 0 },
        "note": { "type": "string" } } } },
    "nonHumanoid": { "type": "object" }, "borrowed": { "type": "object" },
    "animals": { "type": "object", "required": ["squirrel", "rodent", "deer", "fox"], "additionalProperties": false,
      "properties": {
        "squirrel": { "type": "object", "required": ["min", "max", "autumn"], "properties": { "min": { "type": "integer" }, "max": { "type": "integer" }, "autumn": { "type": "integer" }, "reentryPerDay": { "type": "integer" } } },
        "rodent": { "type": "object", "required": ["bodies"] }, "deer": { "type": "object", "required": ["bodies"] }, "fox": { "type": "object", "required": ["bodies"] } } },
    "supplyOrder": { "type": "array", "items": { "type": "string" } },
    "fullServerCutOrder": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": { "perPhase": { "type": "object", "required": ["frb", "w3c"], "additionalProperties": false,
    "properties": { "frb": { "type": "integer", "minimum": 0 }, "w3c": { "type": "integer", "minimum": 0 } } } }
}
