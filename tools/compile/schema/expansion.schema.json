{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "spicy-rodents/expansion",
  "title": "Batch 2 town expansion layout (data/expansion.json; brief v2 §3, §13a, §15 dec 18; docs/waves/BATCH2_SPEC.md). STUDS. One record per venue with its family (F1 food_shops, F2 civic, F3 leisure, F4 rides_minigame_props), placement, footprint, floor height, entrances and anchors; plus the new streets, pads, paths, rides, zones and the 6 pickups + 4 SUVs. Venue-local points are [X, Y, D] in the AlleyLayout frame (see `frame`).",
  "type": "object",
  "required": ["src", "units", "frame", "families", "foodBaseline", "streets", "pads", "paths", "venues", "rides", "zones", "vehicles", "parkingMoves"],
  "additionalProperties": false,
  "$defs": {
    "family": { "enum": ["F1", "F2", "F3", "F4"] },
    "xz": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
    "xyz": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
    "rect": {
      "type": "object", "required": ["x0", "z0", "x1", "z1"], "additionalProperties": false,
      "properties": { "x0": { "type": "number" }, "z0": { "type": "number" }, "x1": { "type": "number" }, "z1": { "type": "number" } }
    },
    "street": {
      "type": "object", "required": ["id", "name", "family", "kind", "axis", "coord", "start", "end", "width", "joins", "notes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^xs_[a-z0-9_]+$" }, "name": { "type": "string" }, "family": { "$ref": "#/$defs/family" },
        "kind": { "enum": ["asphalt", "concrete", "cobble"] }, "axis": { "enum": ["x", "z"] },
        "coord": { "type": "number" }, "start": { "type": "number" }, "end": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "sidewalk": { "type": "object", "required": ["width", "offset"], "additionalProperties": false,
          "properties": { "width": { "type": "number", "exclusiveMinimum": 0 }, "offset": { "type": "number", "exclusiveMinimum": 0 } } },
        "joins": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "pad": {
      "type": "object", "required": ["id", "family", "kind", "rect", "notes"], "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^xp_[a-z0-9_]+$" }, "family": { "$ref": "#/$defs/family" },
        "kind": { "enum": ["asphalt", "concrete", "forecourt", "parking", "plaza"] },
        "rect": { "$ref": "#/$defs/rect" }, "keeps": { "type": "array", "items": { "type": "string" } }, "notes": { "type": "string" }
      }
    },
    "path": {
      "type": "object", "required": ["id", "family", "kind", "width", "points", "notes"], "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^xpath_[a-z0-9_]+$" }, "family": { "$ref": "#/$defs/family" },
        "kind": { "enum": ["boardwalk", "concrete", "path", "steps"] }, "width": { "type": "number", "exclusiveMinimum": 0 },
        "points": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/xz" } }, "notes": { "type": "string" }
      }
    },
    "entrance": {
      "type": "object", "required": ["id", "at", "width", "kind", "path"], "additionalProperties": false,
      "properties": {
        "id": { "type": "string" }, "at": { "$ref": "#/$defs/xz" }, "width": { "type": "number", "exclusiveMinimum": 0 },
        "kind": { "enum": ["door", "double_door", "gate", "opening", "service_door", "service_window"] },
        "path": { "type": "string", "pattern": "^(frontage|alley|forecourt|inside|xpath_[a-z0-9_]+)$" }
      }
    },
    "anchor": {
      "type": "object", "required": ["id", "kind", "at", "yaw", "owner"], "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "kind": { "enum": ["access", "appliance", "arena", "barber_chair", "barber_pole", "bell", "billboard", "bird_feeder", "cooler",
          "counter", "curio", "deck", "display", "dock", "dumpster", "exhibit", "garden_bed", "gig_post", "guard_post", "instrument",
          "interact", "item_shelf", "landmark", "minigame", "parking", "pet_home", "picture_book", "playground", "prop", "radio",
          "readable", "ride", "ride_cable", "ride_end", "ride_start", "room", "sand", "seat", "shed", "sign", "squirrel_block",
          "staff_post", "table", "vehicle_spot", "vending", "yard", "zone"] },
        "at": { "$ref": "#/$defs/xyz" }, "yaw": { "type": "number", "minimum": -360, "maximum": 360 },
        "owner": { "$ref": "#/$defs/family" },
        "note": { "type": "string" }, "forage": { "enum": ["dumpster", "garden", "bird_feeder", "compost"] },
        "game": { "enum": ["racquetball", "volleyball", "giant_jenga", "tilt_labyrinth", "bead_maze"] },
        "ride": { "enum": ["sky_lift", "parasail", "wind_tunnel", "jetski"] },
        "gig": { "enum": ["gig_delivery", "gig_serve"] }, "item": { "type": "string" }, "book": { "type": "string" },
        "serves": { "type": "string" }, "reputation": { "type": "boolean" }
      }
    },
    "venue": {
      "type": "object",
      "required": ["id", "family", "type", "name", "district", "status", "position", "facing", "yaw", "footprint", "site", "storeys",
        "height", "floorY", "ground", "entrances", "anchors", "features", "partBudget", "notes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^f[1-4]_[a-z0-9_]+$" }, "family": { "$ref": "#/$defs/family" },
        "type": { "enum": ["church", "clinic", "community_garden", "gazebo", "house", "jetski_rental", "lounge_classic", "lounge_scifi",
          "mall_small", "museum", "parasail_launch", "park", "racquet_club", "restaurant_bakery", "restaurant_cafe", "restaurant_chinese",
          "restaurant_diner", "restaurant_grill", "restaurant_hilltop", "restaurant_pizza", "restaurant_seafood", "restaurant_taco",
          "school", "shop_antique", "shop_barber", "shop_bookshop", "shop_corner", "shop_hardware", "shop_laundromat", "shop_music",
          "shop_pet", "skylift_station", "steakhouse", "tv_station", "upgrade"] },
        "name": { "type": "string", "minLength": 1 }, "district": { "type": "string" },
        "status": { "enum": ["new", "upgrade"] }, "existingLot": { "type": "string" }, "inside": { "type": "string" },
        "food": { "enum": ["bakery", "bar_and_grill", "cafe", "chinese", "diner", "hilltop_bistro", "ice_cream", "pizza", "seafood",
          "steakhouse", "taco"] },
        "approval": { "type": "string" },
        "position": { "type": "object", "required": ["x", "z"], "additionalProperties": false,
          "properties": { "x": { "type": "number" }, "z": { "type": "number" } } },
        "facing": { "enum": ["+X", "-X", "+Z", "-Z", "yaw"] }, "yaw": { "type": "number", "minimum": -6.3, "maximum": 6.3 },
        "footprint": { "type": "object", "required": ["w", "d"], "additionalProperties": false,
          "properties": { "w": { "type": "number", "exclusiveMinimum": 0 }, "d": { "type": "number", "exclusiveMinimum": 0 } } },
        "site": { "type": "object", "required": ["x0", "x1", "d0", "d1"], "additionalProperties": false,
          "properties": { "x0": { "type": "number" }, "x1": { "type": "number" }, "d0": { "type": "number" }, "d1": { "type": "number" } } },
        "storeys": { "type": "integer", "minimum": 1, "maximum": 6 }, "height": { "type": "number", "minimum": 0 },
        "floorY": { "type": "number" },
        "ground": { "type": "object", "required": ["min", "max"], "additionalProperties": false,
          "properties": { "min": { "type": "number" }, "max": { "type": "number" } } },
        "entrances": { "type": "array", "items": { "$ref": "#/$defs/entrance" } },
        "anchors": { "type": "array", "items": { "$ref": "#/$defs/anchor" } },
        "features": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_]+$" } },
        "partBudget": { "type": "integer", "minimum": 0, "maximum": 5000 }, "notes": { "type": "string" }
      }
    },
    "ride": {
      "type": "object", "required": ["id", "kind", "family", "from", "to", "camera", "points", "notes"], "additionalProperties": false,
      "properties": {
        "id": { "enum": ["sky_lift", "parasail", "wind_tunnel", "jetski"] }, "kind": { "enum": ["cable", "towed_spline", "float_volume", "steerable"] },
        "family": { "$ref": "#/$defs/family" }, "from": { "type": "string" }, "to": { "type": "string" },
        "camera": { "const": "firstPerson" }, "points": { "type": "array", "items": { "$ref": "#/$defs/xyz" } },
        "cabins": { "type": "integer", "minimum": 1 }, "speed": { "type": "number", "exclusiveMinimum": 0 },
        "durationS": { "type": "number", "exclusiveMinimum": 0 }, "chuteHeight": { "type": "number" },
        "instructors": { "type": "integer" },
        "balls": { "type": "object", "required": ["base", "paidAdd"], "additionalProperties": false,
          "properties": { "base": { "type": "integer" }, "paidAdd": { "type": "integer" } } },
        "zone": { "type": "string" }, "notes": { "type": "string" }
      }
    },
    "zone": {
      "type": "object", "required": ["id", "kind", "family", "rect", "notes"], "additionalProperties": false,
      "properties": { "id": { "type": "string", "pattern": "^zone_[a-z0-9_]+$" }, "kind": { "enum": ["jetski_water", "kite"] },
        "family": { "$ref": "#/$defs/family" }, "rect": { "$ref": "#/$defs/rect" }, "notes": { "type": "string" } }
    },
    "vehicle": {
      "type": "object", "required": ["id", "kind", "x", "z", "yaw", "at", "family"], "additionalProperties": false,
      "properties": { "id": { "type": "string", "pattern": "^veh_[a-z0-9_]+$" }, "kind": { "enum": ["pickup", "suv"] },
        "x": { "type": "number" }, "z": { "type": "number" }, "yaw": { "type": "number" }, "at": { "type": "string" },
        "family": { "$ref": "#/$defs/family" } }
    }
  },
  "properties": {
    "$schema": { "type": "string" }, "src": { "type": "string" }, "units": { "const": "studs" }, "frame": { "type": "string" },
    "families": { "type": "object", "required": ["F1", "F2", "F3", "F4"], "additionalProperties": false,
      "properties": { "F1": { "const": "food_shops" }, "F2": { "const": "civic" }, "F3": { "const": "leisure" }, "F4": { "const": "rides_minigame_props" } } },
    "foodBaseline": { "type": "array", "items": { "type": "object", "required": ["lot", "name", "food", "enterable"], "additionalProperties": false,
      "properties": { "lot": { "type": "string" }, "name": { "type": "string" }, "food": { "type": "string" }, "enterable": { "type": "boolean" } } } },
    "streets": { "type": "array", "items": { "$ref": "#/$defs/street" } },
    "pads": { "type": "array", "items": { "$ref": "#/$defs/pad" } },
    "paths": { "type": "array", "items": { "$ref": "#/$defs/path" } },
    "venues": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/venue" } },
    "rides": { "type": "array", "items": { "$ref": "#/$defs/ride" } },
    "zones": { "type": "array", "items": { "$ref": "#/$defs/zone" } },
    "vehicles": { "type": "array", "items": { "$ref": "#/$defs/vehicle" } },
    "parkingMoves": { "type": "array", "items": { "type": "object", "required": ["src", "from", "to", "yaw", "reason"], "additionalProperties": false,
      "properties": { "src": { "type": "string" }, "from": { "$ref": "#/$defs/xz" }, "to": { "$ref": "#/$defs/xz" }, "yaw": { "type": "number" },
        "reason": { "type": "string" } } } }
  }
}
