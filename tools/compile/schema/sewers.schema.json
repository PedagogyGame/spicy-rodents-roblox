{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "spicy-rodents/sewers",
  "title": "The storm drains under the town (data/sewers.json; BRIEF_ADDENDUM D8). STUDS, world space, y up, north = +z. Compiled through Shared/World/SewerLayout.build (its header is the interface).",
  "type": "object",
  "required": ["src", "units", "routeIds", "art", "sections", "junction", "shaft", "carve", "mouth", "lampEvery", "pipes"],
  "additionalProperties": false,
  "$defs": {
    "xz": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
    "section": { "type": "object", "required": ["art", "innerHalf", "outerHalf", "below", "crown", "spring", "walkway", "routeOffset", "width", "headroom", "lamp"], "additionalProperties": false,
      "description": "A passage section from the owner's art at art.studsPerMetre, measured from the passage axis at the walkway top: the route runs routeOffset off the axis on a walkway.",
      "properties": {
        "art": { "type": "string" },
        "innerHalf": { "type": "number", "exclusiveMinimum": 0 },
        "outerHalf": { "type": "number", "exclusiveMinimum": 0 },
        "below": { "type": "number", "minimum": 0, "description": "the outer bottom under the walkway top" },
        "crown": { "type": "number", "exclusiveMinimum": 0, "description": "the vault's outer top over the walkway top" },
        "spring": { "type": "number", "exclusiveMinimum": 0 },
        "walkway": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
        "routeOffset": { "type": "number", "minimum": 0 },
        "water": { "type": "number" },
        "width": { "type": "number", "minimum": 1.6, "description": "the walkway width the enclosure gives the body" },
        "headroom": { "type": "number", "minimum": 1.7, "description": "the vault over the body's outer edge" },
        "lamp": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" }, "description": "a lamp's distance off the axis and height over the walkway" },
        "note": { "type": "string" } } },
    "mouth": { "type": "object", "required": ["id", "kind", "name", "toward", "at", "ground", "rungs"], "additionalProperties": false,
      "description": "A street mouth: `at` is where the squirrel stands to go down (and stands after coming up), on the street at `ground`; the route goes straight down from it, rungGap off the shaft's `rungs` wall. `out` is the rung side (the way a body steps out). `opening` [x0, x1, z0, z1] is the hole the frame leaves when the shaft's top is not all open.",
      "properties": {
        "id": { "type": "string", "pattern": "^P\\d\\.[A-Z]+$" },
        "kind": { "enum": ["grate", "cover"] },
        "name": { "type": "string" },
        "toward": { "type": "string", "description": "What the squirrel faces walking in (the way into the opening, away from the rung side), by the street or landmark: the words on screen. Map compass words are mirrored against x here (Shared/Map/MapModel: east is -x), so none are used." },
        "at": { "$ref": "#/$defs/xz" },
        "ground": { "type": "number" },
        "rungs": { "enum": ["+x", "-x", "+z", "-z"] },
        "opening": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } },
        "reach": { "type": "number", "exclusiveMinimum": 0 },
        "rise": { "type": "number", "minimum": 0 } } },
    "route": { "type": "object", "required": ["id", "name", "from", "to", "side"], "additionalProperties": false,
      "description": "One enclosed run: from a mouth (t = 0) along the walkway line through `via` [x, z, walkway] to a mouth or the pipe's junction (t = 1). `side`: the walkway is on that side of the passage axis looking from `from`.",
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "side": { "enum": ["left", "right"] },
        "wFrom": { "type": "number" },
        "wTo": { "type": "number" },
        "via": { "type": "array", "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } } } } },
    "surface": { "type": "object", "required": ["from", "to", "points"], "additionalProperties": false,
      "description": "The way over the top between two mouths, as a squirrel would walk it (plan points).",
      "properties": {
        "from": { "type": "string" }, "to": { "type": "string" },
        "points": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/xz" } },
        "note": { "type": "string" } } },
    "pipe": { "type": "object", "required": ["id", "name", "space", "sign", "section", "walkway", "mouths", "routes", "surface"], "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^P\\d$" },
        "name": { "type": "string" },
        "space": { "type": "string", "pattern": "^sewer\\.[a-z]+$" },
        "sign": { "type": "string" },
        "section": { "type": "string" },
        "walkway": { "type": "number", "description": "the walkway top the route runs on (unless a route says wFrom, wTo, via)" },
        "note": { "type": "string" },
        "mouths": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/mouth" } },
        "junction": { "type": "object", "required": ["at", "straight"], "additionalProperties": false,
          "description": "Where the arms' walkway lines cross (the routes' t = 1) and which arms run straight on into each other.",
          "properties": {
            "at": { "$ref": "#/$defs/xz" },
            "straight": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer" } } } } },
        "routes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/route" } },
        "lightGrates": { "type": "array", "items": { "$ref": "#/$defs/xz" } },
        "surface": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/surface" } } } }
  },
  "properties": {
    "$schema": { "type": "string" },
    "src": { "type": "string" },
    "units": { "const": "studs" },
    "routeIds": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer" } },
    "art": { "type": "object", "required": ["pack", "studsPerMetre"], "additionalProperties": false,
      "properties": { "pack": { "type": "string" }, "studsPerMetre": { "type": "number", "exclusiveMinimum": 0 }, "note": { "type": "string" } } },
    "sections": { "type": "object", "additionalProperties": { "$ref": "#/$defs/section" } },
    "junction": { "type": "object", "required": ["art", "half"], "additionalProperties": false,
      "properties": { "art": { "type": "string" }, "half": { "type": "number", "exclusiveMinimum": 0 }, "note": { "type": "string" } } },
    "shaft": { "type": "object", "required": ["inside", "wall", "rungGap"], "additionalProperties": false,
      "properties": { "inside": { "type": "number", "minimum": 2 }, "wall": { "type": "number", "exclusiveMinimum": 0 }, "rungGap": { "type": "number", "minimum": 0 } } },
    "carve": { "type": "object", "required": ["voxel", "margin", "slabBottom", "cover"], "additionalProperties": false,
      "properties": { "voxel": { "const": 4 }, "margin": { "type": "number", "minimum": 0 }, "slabBottom": { "type": "number" }, "cover": { "type": "number", "minimum": 0 } } },
    "mouth": { "type": "object", "required": ["reach", "rise"], "additionalProperties": false,
      "properties": { "reach": { "type": "number", "exclusiveMinimum": 0 }, "rise": { "type": "number", "minimum": 0 } } },
    "lampEvery": { "type": "number", "exclusiveMinimum": 0 },
    "pipes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pipe" } }
  }
}
