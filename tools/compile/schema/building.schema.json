{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "spicy-rodents/building",
  "title": "Building programme (data/buildings/<id>.json), BUILD_PLAN 3.12 v0. Local lot frame, HTML units.",
  "type": "object",
  "required": ["id", "version", "lot", "builder", "rooms", "doors", "stations", "shelves", "pads", "briefRooms", "src"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string" }, "version": { "type": "integer" }, "lot": { "type": "string" },
    "builder": { "enum": ["Hospital", "PoliceStation"] }, "src": { "type": "string" },
    "wallHeightU": { "type": "number", "exclusiveMinimum": 0 },
    "partitionHeightU": { "type": "number", "exclusiveMinimum": 0 },
    "doorHeightU": { "type": "number", "exclusiveMinimum": 0 },
    "briefRooms": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "rooms": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "name", "rect"], "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "exterior": { "type": "boolean" },
        "rect": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } } } } },
    "doors": { "type": "array", "items": { "$ref": "#/$defs/door" } },
    "stations": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "room", "at"], "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "kind": { "type": "string" }, "room": { "type": "string" }, "at": { "$ref": "#/$defs/xz" } } } },
    "shelves": { "type": "array", "items": { "type": "object", "required": ["id", "room", "at", "lengthU", "levels", "slotsPerLevel"], "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "room": { "type": "string" }, "at": { "$ref": "#/$defs/xz" }, "lengthU": { "type": "number", "exclusiveMinimum": 0 },
        "levels": { "type": "integer", "minimum": 1, "maximum": 6 }, "slotsPerLevel": { "type": "integer", "minimum": 1, "maximum": 12 } } } },
    "pads": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "at", "w", "d"], "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "kind": { "enum": ["player_car", "ai_cruiser", "ambulance"] }, "at": { "$ref": "#/$defs/xz" },
        "w": { "type": "number", "exclusiveMinimum": 0 }, "d": { "type": "number", "exclusiveMinimum": 0 } } } }
  },
  "$defs": {
    "xz": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
    "door": { "type": "object", "required": ["id", "a", "b", "at", "width", "lockable"], "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "a": { "type": "string" }, "b": { "type": "string" }, "at": { "$ref": "#/$defs/xz" },
        "width": { "type": "number", "exclusiveMinimum": 0 }, "lockable": { "type": "boolean" } } }
  }
}
