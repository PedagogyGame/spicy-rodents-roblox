{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "spicy-rodents/interior",
  "title": "Interior template (data/interiors/<id>.json), BUILD_PLAN 3.4. Fractional rects [fx0, fx1, fz0, fz1] (fx along the model RightVector: 0 = the right-hand side seen from the street; fz from back 0 to front 1); widths and sizes in HTML units.",
  "type": "object",
  "required": ["id", "lot", "version", "rooms", "doors", "furniture", "defenderSpawn", "burglarEntry", "remodelSlots", "squirrelRoutes", "src"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" }, "id": { "type": "string" }, "lot": { "type": "string" }, "version": { "type": "integer" }, "src": { "type": "string" },
    "floorU": { "type": "number" }, "wallU": { "type": "number", "exclusiveMinimum": 0 }, "doorHeightU": { "type": "number", "exclusiveMinimum": 0 },
    "rooms": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "name", "rect"], "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "name": { "type": "string" },
        "rect": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0, "maximum": 1 } } } } },
    "doors": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "a", "b", "at", "width", "lockable"], "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "a": { "type": "string" }, "b": { "type": "string" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "lockable": { "type": "boolean" },
        "at": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0, "maximum": 1 } } } } },
    "furniture": { "type": "array", "items": { "type": "object", "required": ["id", "room", "kit", "at", "size"], "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "room": { "type": "string" }, "kit": { "type": "string" }, "hide": { "enum": ["behind", "under", "inside"] },
        "at": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
        "size": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "exclusiveMinimum": 0 } } } } },
    "defenderSpawn": { "type": "object", "required": ["room", "at"], "additionalProperties": false,
      "properties": { "room": { "type": "string" }, "at": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } } } },
    "burglarEntry": { "type": "object", "required": ["door"], "additionalProperties": false, "properties": { "door": { "type": "string" } } },
    "remodelSlots": { "type": "array", "items": { "type": "string" } },
    "squirrelRoutes": { "type": "array", "items": { "type": "object", "required": ["kind"], "additionalProperties": false,
      "properties": { "kind": { "enum": ["counter_top", "shelf_top", "curtain_rail"] }, "slot": { "type": "string" }, "room": { "type": "string" } } } }
  }
}
