{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "spicy-rodents/attractions",
  "title": "Attraction buildings baked on their own (data/attractions.json; brief v2 §13a; BUILD_PLAN §3.17). STUDS, not HTML units. Route points are local [X, Y, D] in the building's frame (Shared/Attractions/AlleyLayout).",
  "type": "object",
  "required": ["attractions", "units", "src"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" }, "src": { "type": "string" }, "units": { "const": "studs" },
    "attractions": { "type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["id", "type", "name", "district", "place", "footprint", "routes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" }, "type": { "enum": ["bowling_alley"] }, "name": { "type": "string" },
        "district": { "type": "string" }, "lanes": { "type": "integer", "minimum": 1, "maximum": 12 },
        "games": { "type": "array", "items": { "type": "string" } },
        "place": { "type": "object", "required": ["x", "z", "floorY", "yaw"], "additionalProperties": false,
          "properties": { "x": { "type": "number" }, "z": { "type": "number" }, "floorY": { "type": "number" }, "yaw": { "type": "number" } } },
        "footprint": { "type": "object", "required": ["x0", "x1", "d0", "d1"], "additionalProperties": false,
          "properties": { "x0": { "type": "number" }, "x1": { "type": "number" }, "d0": { "type": "number" }, "d1": { "type": "number" } } },
        "routes": { "type": "array", "items": {
          "type": "object",
          "required": ["id", "name", "kind", "points", "surfaceRadius"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "integer", "minimum": 9000, "maximum": 9999 }, "name": { "type": "string" },
            "kind": { "enum": ["trunk", "branch", "bridge", "lookout", "roof", "wire", "fence"] },
            "pair": { "type": "integer" }, "surfaceRadius": { "type": "number", "minimum": 0 },
            "visualOffset": { "type": "number" }, "note": { "type": "string" },
            "flags": { "type": "object", "additionalProperties": false, "properties": {
              "autoGrabExcluded": { "type": "boolean" }, "isPole": { "type": "boolean" }, "isGiant": { "type": "boolean" },
              "fixedSurfaceZ": { "type": "boolean" }, "treeTravel": { "type": "boolean" } } },
            "points": { "type": "array", "minItems": 2, "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } } }
          }
        } }
      }
    } }
  }
}
