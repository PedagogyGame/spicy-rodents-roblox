--!strict
-- tools/games/pinball/views.luau: the viewpoints the three pinball machines are looked at from in the offline
-- review renders (tools/review/render.py --views), written from the game's own numbers: the player's view of
-- each machine is Shared/Minigames/Pinball/Cabinet.camera (the eye over the lockdown bar, the same the
-- controller uses), the views from above look straight down each playfield, and the room views stand where a
-- person would. Nothing here is a position of its own: the machines are where AlleyLayout.PINBALLS puts them.
-- Run (repo root, after tools/bake/attractions.luau and tools/review/export.luau):
--   lune run tools/games/pinball/views.luau [out.json, default build/review/pinball_views.json]
--   python -I tools/review/render.py --views build/review/pinball_views.json --out build/review/pinball
-- With a game in play on each machine (tools/games/pinball/inplay.luau: a ball up top, or coming down to a
-- flipper held up): render with --scene build/review/pinball_top.json (or pinball_low.json).
-- The pictures kept in the repository are docs/renders/minigames/pinball/.
local fs = require("@lune/fs")
local process = require("@lune/process")
local serde = require("@lune/serde")
local AlleyLayout = require("../../../src/shared/Attractions/AlleyLayout")
local Cabinet = require("../../../src/shared/Minigames/Pinball/Cabinet")
local Layout = require("../../../src/shared/Minigames/Pinball/Layout")

local out = process.args[1] or "build/review/pinball_views.json"
local doc = serde.decode("json", fs.readFile("data/attractions.json"))
local place: AlleyLayout.Place? = nil
for _, a in doc.attractions do
	if a.id == "bowling_alley" then
		place = { x = a.place.x, z = a.place.z, floorY = a.place.floorY, yaw = a.place.yaw }
	end
end
assert(place, "the bowling alley is not in data/attractions.json")

local GROUPS = { "attractions", "terrain" }
local views: { any } = {}
local NAMES = { "acorn", "rodent", "space" }

local function r3(n: number): number
	return math.floor(n * 1000 + 0.5) / 1000
end
local function room(X: number, Y: number, D: number): { number }
	local x, y, z = AlleyLayout.toWorld(place :: any, X, Y, D)
	return { r3(x), r3(y), r3(z) }
end
local function field(index: number, x: number, y: number, h: number): { number }
	local X, Y, D = Cabinet.point(index, x, y, h)
	return room(X, Y, D)
end
local function add(name: string, desc: string, pos: { number }, look: { number }, fov: number, up: { number }?)
	table.insert(views, { name = name, desc = desc, pos = pos, look = look, fov = fov, up = up, groups = GROUPS })
end

for index = 1, #AlleyLayout.PINBALLS do
	local who = NAMES[index] or tostring(index)
	-- (on a 16:9 screen the display stands beside the table, so the camera keeps only a sliver at the top)
	local reserve = { top = 0.02, bottom = 0.02 }
	local v = Cabinet.camera(index, 16 / 9, "play", reserve)
	add(
		`pb_{who}_player`,
		`Pinball {index} ({who}): the player's view over the lockdown bar (Cabinet.camera, 16:9).`,
		room(v.eye[1], v.eye[2], v.eye[3]),
		room(v.target[1], v.target[2], v.target[3]),
		v.fov
	)
	if who == "rodent" then
		local hv = Cabinet.camera(index, 16 / 9, "high", reserve)
		add(
			`pb_{who}_high`,
			`Pinball {index} ({who}): the second view (V), leaning out over the glass (Cabinet.camera "high", 16:9).`,
			room(hv.eye[1], hv.eye[2], hv.eye[3]),
			room(hv.target[1], hv.target[2], hv.target[3]),
			hv.fov
		)
	end
	-- straight down the playfield's normal, the far end at the top of the picture
	local a, b = field(index, 1.2, 2.45, 0), field(index, 1.2, 3.45, 0)
	add(
		`pb_{who}_above`,
		`Pinball {index} ({who}): the playfield from above, the far end at the top.`,
		field(index, Layout.WIDTH / 2, Layout.LENGTH / 2, 5.2),
		field(index, Layout.WIDTH / 2, Layout.LENGTH / 2, 0),
		58,
		{ r3(b[1] - a[1]), r3(b[2] - a[2]), r3(b[3] - a[3]) }
	)
end
do
	local px, pd = Cabinet.at(2)
	add(
		"pb_row",
		"The three machines along the games room's front wall, from where a person walks up between them and the pool table.",
		room(px + 3.5, 5.6, pd + 9.5),
		room(px, 4.2, pd - 0.5),
		62
	)
	local x1 = Cabinet.at(1)
	add(
		"pb_cabinet_side",
		"ACORN ATTACK from the side and front: legs (the back pair longer), the body, coin door, lockdown bar, backbox.",
		room(x1 - 4.2, 4.6, pd + 5.2),
		room(x1, 3.8, pd),
		55
	)
	local x3 = Cabinet.at(3)
	local bb = Cabinet.BACKBOX
	add(
		"pb_space_backglass",
		"SPACE SQUIRREL's backglass close up, as someone behind the player reads it.",
		room(x3 + 0.5, 6.2, pd + 5),
		room(x3, (bb.y0 + bb.y1) / 2, pd + bb.front),
		45
	)
end

local dir = string.match(out, "^(.*)/[^/]*$")
if dir and not fs.isDir(dir) then
	fs.writeDir(dir)
end
fs.writeFile(
	out,
	serde.encode("json", {
		about = "Pinball review viewpoints, generated by tools/games/pinball/views.luau from the game's Cabinet.",
		defaults = { res = "960x540", samples = 24, groups = GROUPS },
		sun = {
			dir = { 0.7, 0.55, -0.45 },
			strength = 3.6,
			color = { 1.0, 0.86, 0.68 },
			angleDeg = 1.5,
			skyStrength = 1.0,
		},
		views = views,
	}, true)
)
print(`pinball views: {#views} -> {out}`)
