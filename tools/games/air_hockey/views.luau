--!strict
-- tools/games/air_hockey/views.luau: the viewpoints the air hockey table is looked at from in the offline
-- review renders (tools/review/render.py --views), written from the game's own layout: each player's first
-- person camera and the view from above are Shared/Minigames/AirHockey/Layout.camera, the same numbers the
-- client's controller uses, so the pictures are what a player at the table is shown.
-- Run (repo root, after tools/bake/attractions.luau and tools/review/export.luau):
--   lune run tools/games/air_hockey/views.luau [out.json, default build/review/air_hockey_views.json]
--   python -I tools/review/render.py --views build/review/air_hockey_views.json --out build/review/air_hockey
-- The pictures kept in the repository are docs/renders/minigames/air_hockey/.
local fs = require("@lune/fs")
local process = require("@lune/process")
local serde = require("@lune/serde")
local AlleyLayout = require("../../../src/shared/Attractions/AlleyLayout")
local Layout = require("../../../src/shared/Minigames/AirHockey/Layout")

local out = process.args[1] or "build/review/air_hockey_views.json"
local doc = serde.decode("json", fs.readFile("data/attractions.json"))
local place: AlleyLayout.Place? = nil
for _, a in doc.attractions do
	if a.id == Layout.SITE then
		place = { x = a.place.x, z = a.place.z, floorY = a.place.floorY, yaw = a.place.yaw }
	end
end
assert(place, "the bowling alley is not in data/attractions.json")

local GROUPS = { "attractions", "terrain" }
local views: { any } = {}

local function r3(n: number): number
	return math.floor(n * 1000 + 0.5) / 1000
end
-- a point of the table (model metres) / of the room (alley studs) in the world
local function model(p: { number }): { number }
	local x, y, z = Layout.toWorld(place :: any, p[1], p[2], p[3])
	return { r3(x), r3(y), r3(z) }
end
local function room(X: number, Y: number, D: number): { number }
	local x, y, z = AlleyLayout.toWorld(place :: any, X, Y, D)
	return { r3(x), r3(y), r3(z) }
end
local function add(name: string, desc: string, pos: { number }, look: { number }, fov: number, up: { number }?)
	table.insert(views, { name = name, desc = desc, pos = pos, look = look, fov = fov, up = up, groups = GROUPS })
end

for side = 0, 1 do
	local v = Layout.camera(side, false)
	local who = Layout.SIDE_NAMES[side]
	add(
		`ah_first_person_{string.lower(who)}`,
		`Air hockey: the {who} player's first-person view (Layout.camera: the game's own eye and target).`,
		model(v.eye),
		model(v.target),
		v.fov
	)
end
do
	local v = Layout.camera(0, true)
	-- (the view from above looks straight down: the far end is up the screen)
	local a, b = model({ 0, 0, Layout.BED_Z }), model({ 0, 1, Layout.BED_Z })
	add(
		"ah_overhead",
		"Air hockey: the view from above on V (Glacier's end at the bottom), under the room's ceiling.",
		model(v.eye),
		model(v.target),
		v.fov,
		{ r3(b[1] - a[1]), 0, r3(b[3] - a[3]) }
	)
end
add(
	"ah_hero",
	"Air hockey: the table three-quarter on, as in the owner's title picture (Glacier's end near).",
	model({ 2.1, -2.3, 2.15 }),
	model({ 0, 0.05, 0.86 }),
	50
)
add(
	"ah_goal_ember",
	"Air hockey: the Ember goal close up (mouth, lit lintel, rounded posts, end rails, mallet at home).",
	model({ 0.55, 0.25, 1.32 }),
	model({ 0, 1.2, 0.9 }),
	50
)
do
	local c = Layout.CENTRE
	add(
		"ah_room_walk_up",
		"Games room: walking up from the doorway at eye height: bumper pool on the right, the air hockey table along the back wall, the fortune teller's corner beyond.",
		room(28.5, 5.2, 6.5),
		room(c.x + 2, 2.6, c.d),
		70
	)
	add(
		"ah_room_from_darts",
		"Games room: from beside the dart mat at eye height: the Ember end of the table with its mat, the aisle between the table and the bumper pool.",
		room(49, 5.2, 17.5),
		room(c.x, 2.8, c.d),
		65
	)
	local a, b = room(40, 0, 20), room(40, 0, 21)
	add(
		"ah_room_above",
		"Games room, back half, straight down from under the ceiling (the back wall at the top): the table, both players' mats, bumper pool, the dart mat, the fortune teller and her ferns, and the floor left to walk on.",
		room(40, AlleyLayout.CEILING_Y - 0.25, 20.5),
		room(40, 0, 20.5),
		82,
		{ r3(b[1] - a[1]), 0, r3(b[3] - a[3]) }
	)
end

local dir = string.match(out, "^(.*)/[^/]*$")
if dir and not fs.isDir(dir) then
	fs.writeDir(dir)
end
fs.writeFile(
	out,
	serde.encode("json", {
		about = "Air hockey review viewpoints, generated by tools/games/air_hockey/views.luau from the game's Layout.",
		defaults = { res = "960x540", samples = 24, groups = GROUPS },
		sun = {
			dir = { 0.7, 0.55, -0.45 },
			strength = 3.6,
			color = { 1.0, 0.86, 0.68 },
			angleDeg = 1.5,
			skyStrength = 1.0,
		},
		views = views,
	}, true)
)
print(`air hockey views: {#views} -> {out}`)
